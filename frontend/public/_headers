# Cloudflare Pages Hardened Security & Cache Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://api.groq.com https://api.telegram.org https://*.workers.dev; frame-ancestors 'none'; object-src 'none'; base-uri 'self';

# Cache immutable bundled assets for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache mascot stickers for 30 days with stale-while-revalidate
/stickers/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
