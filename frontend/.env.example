# GMC Thiruvallur Student Council Portal - Frontend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# (If left empty, the application will automatically run in local interactive Demo Mode!)

# Firebase Configuration (From Firebase Console > Project Settings > General > Your Apps)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Cloudflare Worker Backend API URL (Optional - leave empty for mock / direct Firestore mode)
# Example: https://gmc-portal-api.your-subdomain.workers.dev
VITE_API_BASE_URL=""
