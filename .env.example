# ==============================================================================
# GMC Thiruvallur Student Council Portal - Environment Secrets Configuration
# 100% Free Tier Compatible (Cloudflare Pages + Cloudflare Workers + AI APIs)
# Zero monthly cloud hosting costs ($0 / month)
# ==============================================================================
#
# QUICK START GUIDE:
# 1. Cloudflare Pages (Frontend):
#    - Connect your GitHub repo to Cloudflare Pages
#    - Build Command: npm --prefix frontend run build
#    - Output Directory: frontend/dist
#    - Add Environment Variables from SECTION A below
#
# 2. Cloudflare Workers (Backend API):
#    - Deploy via CLI: cd worker && npx wrangler deploy
#    - Add Secrets from SECTION B below via `wrangler secret put <KEY>` or Cloudflare dashboard
#
# ==============================================================================
# SECTION A: FRONTEND ENVIRONMENT VARIABLES (Set in Cloudflare Pages)
# ==============================================================================

# 1. Council Master Security Passcode / Token
# Set any secure phrase or token here. Council members enter this on the login page.
VITE_COUNCIL_AUTH_TOKEN="GMC@Council2026!Admin"

# 2. Cloudflare Worker API URL (Decoupled Backend)
# After deploying your Cloudflare Worker, paste its URL here (e.g., https://gmc-backend.<account>.workers.dev)
# If left empty, the frontend runs standalone with zero-crash mock/client-side emulation!
VITE_API_BASE_URL=""

# 3. Firebase Configuration (Optional - for Cloud Firestore persistence)
# If left empty, the application uses interactive local persistence
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""


# ==============================================================================
# SECTION B: BACKEND WORKER SECRETS (Set in Cloudflare Worker)
# ==============================================================================
# In worker directory, copy .dev.vars.example to .dev.vars for local testing,
# or set secrets in Cloudflare Dashboard: Worker > Settings > Variables and Secrets.

# 1. Council Master Security Passcode (Matches VITE_COUNCIL_AUTH_TOKEN)
COUNCIL_AUTH_TOKEN="GMC@Council2026!Admin"

# 2. Free AI Intelligence Keys (Sentiment triage, summary & executive reports)
# Groq API Key (Ultra-fast free tier: https://console.groq.com)
GROQ_API_KEY=""
# Google Gemini API Key (Generous free tier: https://aistudio.google.com)
GEMINI_API_KEY=""

# 3. Free Telegram Council Bot (2-way live chat relay & grievance alerts)
# Token from Telegram @BotFather
TELEGRAM_BOT_TOKEN=""
# Council Group Chat ID or Admin Telegram user ID
TELEGRAM_ADMIN_CHAT_ID=""
# Optional secret for webhook verification
TELEGRAM_WEBHOOK_SECRET=""

# 4. Optional Firebase Service Account (Server-side Firestore writes)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 5. Optional Gmail API (For council email notifications)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
COUNCIL_RECIPIENT_EMAIL=""
